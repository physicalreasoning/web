---
import Base from '../../layouts/Base.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { roles } from '../../data/roles';

const description = 'Open roles at Physical Reasoning.';
const listed = roles.filter((role) => role.listing);
---
<Base
  title="Join us · Physical Reasoning"
  description={description}
  path="/join/"
  og={{ title: 'Join us · Physical Reasoning', description, type: 'website' }}
>
<style is:global>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  :root {
    color-scheme: light only;
    --paper: #FFFFFF;
    --ink: #000000;
    --muted: #6B6B6B;
    --rule: #E8E8E8;
    --serif: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif;
    --mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
  }

  body {
    font-family: var(--serif);
    color: var(--ink);
    background: var(--paper);
    line-height: 1.65;
    font-size: 17px;
  }
  .wrap { max-width: 40rem; margin: 0 auto; padding: 0 1.25rem; }

  nav {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 1.8rem 0;
  }
  .wordmark {
    font-family: var(--mono);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--ink);
    text-decoration: none;
  }
  .back {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
  }
  .back:hover { color: var(--ink); }

  header { padding: 3.5rem 0 2.5rem; }
  header h1 { font-size: 1.8rem; font-weight: 400; }
  header p { margin-top: 0.8rem; color: var(--muted); }
  header a { color: var(--ink); }

  .roles { list-style: none; border-top: 1px solid var(--rule); }
  .roles li {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 1.2rem;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .roles .meta {
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--muted);
    padding-top: 0.35rem;
  }
  .roles h2 { font-size: 1.05rem; font-weight: 600; line-height: 1.45; }
  .roles h2 a { color: var(--ink); text-decoration: none; }
  .roles h2 a:hover { text-decoration: underline; }
  .roles h2 a:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
  .roles p { color: var(--muted); font-size: 0.92rem; margin-top: 0.35rem; }
  .apply {
    display: inline-block;
    margin-top: 0.7rem;
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 1px;
  }
  .apply:hover { color: var(--muted); border-color: var(--muted); }
  .apply:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }

  footer {
    padding: 2.5rem 0 3rem;
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  @media (max-width: 480px) {
    .roles li { grid-template-columns: 1fr; gap: 0.3rem; }
  }
</style>
<div class="wrap">
  <SiteNav>
    <a class="back" href="/">&larr; Home</a>
  </SiteNav>

  <header>
    <h1>Join us</h1>
    <p>Open roles at Physical Reasoning. Select a role to read more and apply.</p>
    <p>You do not need a role to contribute: <a href="/start/">start here</a>, or pick one of the <a href="/open-problems/">open problems</a>.</p>
  </header>

  <ul class="roles">
    {listed.map((role) => (
      <li>
        <span class="meta">{role.listing!.tags.map((tag, i) => <>{i > 0 && <br />}{tag}</>)}</span>
        <div>
          <h2><a href={`/join/${role.slug}/`}>{role.title}</a></h2>
          <p>{role.listing!.summary}</p>
          <a class="apply" href={`/join/${role.slug}/`}>Apply &rarr;</a>
        </div>
      </li>
    ))}
  </ul>

  <SiteFooter />
</div>
</Base>
