---
import Base from '../../layouts/Base.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import JsonLd from '../../components/JsonLd.astro';
import { posts } from '../../data/posts';

const description = 'Research notes from Physical Reasoning on world models, prediction, and how we evaluate them.';
const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Physical Reasoning Blog',
  url: new URL('/blog/', Astro.site).href,
  publisher: { '@type': 'Organization', name: 'Physical Reasoning' },
}];
---
<Base
  title="Blog · Physical Reasoning"
  description={description}
  path="/blog/"
  og={{ title: 'Blog · Physical Reasoning', description, type: 'website' }}
>
<style is:global>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  :root {
    color-scheme: light only;
    --paper: #FFFFFF;
    --ink: #000000;
    --muted: #6B6B6B;
    --rule: #E8E8E8;
    --serif: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif;
    --mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
  }

  body {
    font-family: var(--serif);
    color: var(--ink);
    background: var(--paper);
    line-height: 1.65;
    font-size: 17px;
  }
  .wrap { max-width: 40rem; margin: 0 auto; padding: 0 1.25rem; }

  nav {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 1.8rem 0;
  }
  .wordmark {
    font-family: var(--mono);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--ink);
    text-decoration: none;
  }
  .back {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
  }
  .back:hover { color: var(--ink); }

  header { padding: 3.5rem 0 2.5rem; }
  header h1 { font-size: 1.8rem; font-weight: 400; }
  header p { margin-top: 0.8rem; color: var(--muted); }

  .papers { list-style: none; border-top: 1px solid var(--rule); }
  .papers li {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 1.2rem;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .papers time {
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--muted);
    padding-top: 0.35rem;
    font-variant-numeric: tabular-nums;
  }
  .papers h2 { font-size: 1.05rem; font-weight: 600; line-height: 1.45; }
  .papers h2 a { color: var(--ink); text-decoration: none; }
  .papers h2 a:hover { text-decoration: underline; }
  .papers h2 a:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
  .papers p { color: var(--muted); font-size: 0.92rem; margin-top: 0.35rem; }

  footer {
    padding: 2.5rem 0 3rem;
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  @media (max-width: 480px) {
    .papers li { grid-template-columns: 1fr; gap: 0.3rem; }
  }
</style>
<div class="wrap">
  <SiteNav>
    <a class="back" href="/">&larr; Home</a>
  </SiteNav>

  <header>
    <h1>Blog</h1>
    <p>Notes from the lab on world models, prediction, and how we evaluate them.</p>
  </header>

  <ul class="papers">
    {posts.map((post) => {
      const month = post.published.slice(0, 7);
      return (
        <li>
          <time datetime={month}>{month.replace('-', ' · ')}</time>
          <div>
            <h2><a href={`/blog/${post.slug}/`}>{post.title}</a></h2>
            <p>{post.summary}</p>
          </div>
        </li>
      );
    })}
  </ul>

  <SiteFooter />
</div>
<JsonLd data={jsonLd} />
</Base>
