---
// The document shell shared by every page: charset, viewport, SEO and social metadata.
// Page-specific styles and JSON-LD go in the "head" slot; everything else is the body.
interface Props {
  title: string;
  description?: string;
  /** Path of the page, e.g. "/blog/". Sets the canonical URL and og:url. */
  path?: string;
  og?: {
    title: string;
    description?: string;
    type?: 'website' | 'article';
    publishedTime?: string;
  };
  /** Emit a summary_large_image Twitter card alongside the Open Graph tags. */
  twitterCard?: boolean;
}

const { title, description, path, og, twitterCard = true } = Astro.props;
const canonical = path ? new URL(path, Astro.site).href : undefined;
const ogImage = new URL('/og.png', Astro.site).href;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="color-scheme" content="light only">
<meta name="viewport" content="width=device-width, initial-scale=1">
{description && <meta name="description" content={description}>}
{og && (
  <>
    <meta property="og:title" content={og.title}>
    {og.description && <meta property="og:description" content={og.description}>}
    {canonical && <meta property="og:url" content={canonical}>}
    {og.type && <meta property="og:type" content={og.type}>}
    {og.publishedTime && <meta property="article:published_time" content={og.publishedTime}>}
    <meta property="og:image" content={ogImage}>
    {twitterCard && <meta name="twitter:card" content="summary_large_image">}
  </>
)}
{canonical && <link rel="canonical" href={canonical}>}
<link rel="icon" type="image/svg+xml" href="/logo.svg">
<title>{title}</title>
<slot name="head" />
</head>
<body>
<slot />
</body>
</html>
